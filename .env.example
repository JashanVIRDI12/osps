# ---------------------------------------------------------------- EmailJS
# Delivery for the quote form (components/sections/QuoteForm.tsx).
#
# All three are public identifiers — the browser SDK inlines them into the
# client bundle, so they are not secrets. They live here so the account can
# be swapped per environment. Restrict the public key to your domain under
# EmailJS → Account → Security instead of trying to hide it.
#
# Copy this file to .env.local for local work, and set the same three
# variables on the host (Vercel → Settings → Environment Variables), or the
# form will render a "not configured" error instead of sending.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_6hlbtnk
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_arae85o
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=ZnZGcLpxgGxsGdvsb
