*.tsbuildinfo
.eslintcache
.turbo/
.swc/

# ----------------------------------------------------------------- testing
coverage/

# ------------------------------------------------------------- environment
# Never commit real credentials. `.env.example` is deliberately let through so
# the set of required variable names stays documented in the repo.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# -------------------------------------------------------------- deployment
.vercel/
.netlify/

